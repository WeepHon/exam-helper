<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="题库助手 · LSPosed 模块"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="屏幕题目识别 + 悬浮窗答案，支持导入本地题库"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="① 使用步骤"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="1. 在 LSPosed 管理器中启用本模块并勾选目标 App（可选）\n2. 开启悬浮窗权限\n3. 开启无障碍服务（用于直接读取屏幕文字）\n4. 回到目标页面，点击悬浮球 → 识别题目 → 查看答案"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="② 权限开关"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/primary" />

        <Button
            android:id="@+id/btnOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="开启悬浮窗权限" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="开启无障碍服务" />

        <Button
            android:id="@+id/btnStartBall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="显示悬浮球" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="③ 联网搜索（可选，未配置时仅用本地题库）"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="快捷填充服务商（点选后只需填 API Key）"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLlmDeepseek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="4dp"
                android:text="DeepSeek" />

            <Button
                android:id="@+id/btnLlmQwen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:layout_marginStart="4dp"
                android:text="通义千问" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLlmKimi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="4dp"
                android:text="Kimi" />

            <Button
                android:id="@+id/btnLlmGlm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:layout_marginStart="4dp"
                android:text="智谱GLM" />
        </LinearLayout>

        <EditText
            android:id="@+id/etLlmName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="配置名称（用于区分不同 Key，如：我的DeepSeek）"
            android:inputType="text"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etLlmUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="LLM API 地址（OpenAI 兼容，如 https://api.openai.com/v1）"
            android:inputType="textUri"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etLlmKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="API Key"
            android:inputType="text"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etLlmModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="模型名（如 gpt-4o-mini）"
            android:inputType="text"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSaveLlm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="保存联网配置" />

        <TextView
            android:id="@+id/tvCurrentLlm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="当前使用：未配置"
            android:textSize="13sp"
            android:textColor="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="已保存的模型配置（点选切换当前使用，编=编辑，删=删除）"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            android:id="@+id/llLlmProfiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="④ 本地题库管理（支持同时启用多个题库）"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="导入 txt / docx / pdf 会自动识别为「问答」或「条文」题库，勾选即启用，答题时合并检索。"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/btnImport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="选择文件导入题库" />

        <LinearLayout
            android:id="@+id/llBankList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnClearImport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="清空所有导入的题库（内置知识库除外）" />

        <TextView
            android:id="@+id/tvImportStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="未导入题库"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="状态：就绪"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/btnCopyLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="复制日志（排查问题用）" />

        <Button
            android:id="@+id/btnClearLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="清除本地日志" />
    </LinearLayout>
</ScrollView>
